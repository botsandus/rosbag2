# Subscribe to additional topics for recording.
# Topics already subscribed will be ignored. Topics not found on the graph
# will be reported in unavailable_topics.
string[] topics
---
# Topics that were successfully subscribed.
string[] subscribed_topics
# Topics that were not found on the graph.
string[] unavailable_topics
# Return code. Returns 0 on success, 1 on error.
int32 return_code
# Error string. Empty if no error occurred.
string error_string
